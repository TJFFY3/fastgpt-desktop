{
  "name": "fastgpt-desktop",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build:safe-files": "node scripts/build-safe-files.mjs",
    "dev": "npm run dev -w @fastgpt/desktop",
    "build": "npm run build -w @fastgpt/desktop",
    "build:test": "npm run build -w @fastgpt/desktop -- --mode test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:test && playwright test",
    "package:dir": "npm run build && npm run package:dir -w @fastgpt/desktop"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
